[
  {
    "name": "payload-field-names-and-dynamic-keys",
    "source": {
      "routines": {
        "report": {
          "actions": [
            {
              "type": "send_http_request",
              "body": {
                "name": "{params[name]}",
                "node_states": {
                  "{node[name]}": {
                    "type": "{params[type]}",
                    "operator": "{params[operator]}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "expected": {
      "routines": {
        "report": {
          "actions": [
            {
              "type": "send_http_request",
              "body": {
                "name": "${{ params[\"name\"] }}",
                "node_states": {
                  "${{ node[\"name\"] }}": {
                    "type": "${{ params[\"type\"] }}",
                    "operator": "${{ params[\"operator\"] }}"
                  }
                }
              }
            }
          ]
        }
      },
      "expression_engine": "cel-v1"
    },
    "converted": 4
  },
  {
    "name": "write-json-and-argument-values",
    "source": {
      "routines": {
        "save": {
          "actions": [
            {
              "type": "write_json",
              "content": {
                "name": "{params[name]}",
                "{params[key]}": {
                  "name": "{params[name]}"
                }
              }
            },
            {
              "type": "execute_routine",
              "routine": "other",
              "args": {
                "name": "{params[name]}",
                "type": "{params[type]}"
              }
            }
          ]
        }
      }
    },
    "expected": {
      "routines": {
        "save": {
          "actions": [
            {
              "type": "write_json",
              "content": {
                "name": "${{ params[\"name\"] }}",
                "${{ params[\"key\"] }}": {
                  "name": "${{ params[\"name\"] }}"
                }
              }
            },
            {
              "type": "execute_routine",
              "routine": "other",
              "args": {
                "name": "${{ params[\"name\"] }}",
                "type": "${{ params[\"type\"] }}"
              }
            }
          ]
        }
      },
      "expression_engine": "cel-v1"
    },
    "converted": 5
  },
  {
    "name": "context-is-a-valid-definition-name",
    "source": {
      "routines": {
        "context": {
          "actions": [
            {
              "type": "send_http_request",
              "body": {
                "{params[key]}": "{params[value]}"
              }
            }
          ]
        }
      },
      "pipeline": {
        "args": {
          "params": {
            "default": {
              "type": "object",
              "default": {
                "name": "{sys[name]}"
              }
            }
          },
          "nodes": []
        }
      }
    },
    "expected": {
      "routines": {
        "context": {
          "actions": [
            {
              "type": "send_http_request",
              "body": {
                "${{ params[\"key\"] }}": "${{ params[\"value\"] }}"
              }
            }
          ]
        }
      },
      "pipeline": {
        "args": {
          "params": {
            "default": {
              "type": "object",
              "default": {
                "name": "${{ sys[\"name\"] }}"
              }
            }
          },
          "nodes": []
        }
      },
      "expression_engine": "cel-v1"
    },
    "converted": 3
  },
  {
    "name": "dynamic-node-name-still-blocked",
    "source": {
      "pipeline": {
        "main": {
          "nodes": [
            {
              "name": "{params[name]}"
            }
          ]
        }
      }
    },
    "issue": "structural name"
  },
  {
    "name": "dynamic-context-key-still-blocked",
    "source": {
      "pipeline": {
        "main": {
          "context": {
            "{params[key]}": "x"
          },
          "nodes": []
        }
      }
    },
    "issue": "dynamic structural map key"
  },
  {
    "name": "literal-braces-still-blocked",
    "source": {
      "x": "{\"literal\":1}"
    },
    "issue": "unsupported/literal braces"
  },
  {
    "name": "json-looking-args-do-not-render-keys",
    "source": {
      "routines": {
        "r": {
          "actions": [
            {
              "type": "execute_routine",
              "routine": "other",
              "args": {
                "body": {
                  "{params[key]}": "x"
                }
              }
            }
          ]
        }
      }
    },
    "issue": "dynamic structural map key"
  },
  {
    "name": "payload-cel-key-collision-blocked",
    "source": {
      "routines": {
        "r": {
          "actions": [
            {
              "type": "write_json",
              "content": {
                "{params[key]}": 1,
                "${{ params[\"key\"] }}": 2
              }
            }
          ]
        }
      }
    },
    "issue": "duplicate map key after migration"
  }
]
